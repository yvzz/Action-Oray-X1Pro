#!/bin/sh /etc/rc.common
# 监听 USB 上网卡（eth2 / usb0 等），插上自动设为 wan，拔掉回落到出厂设备。
# 逻辑在 /usr/sbin/usbwan-watch。

START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/usbwan-watch
	procd_set_param respawn 3600 5 5
	# 脚本自己用 logger 写 syslog，procd 再把 stdout 收一份就会每条日志出现两次
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# 不要删 /etc/usbwan.last：它是「上次由本服务设置的设备」的唯一记录，
	# 删掉后重启服务会把当前 USB 设备误判成用户手工配置，从此不再接管。
	:
}
