#!/bin/sh /etc/rc.common

START=80
USE_PROCD=1
NAME=cloud-ddns

start_service() {
    # 只有「服务商启用 + 凭据齐全 + 至少一条 A/AAAA 域名记录」三者属于同一
    # 服务商时才真正启动，避免刷完机就空转占用资源。
    # 校验脚本会打印不满足的原因（这里丢弃，LuCI 状态接口会单独取来展示）。
    REASON=$(/usr/share/cloud-ddns/check-config.sh 2>/dev/null)
    if [ $? -ne 0 ]; then
        logger -t cloud-ddns "未满足运行条件，保持停止：$REASON"
        return 0
    fi

    procd_open_instance
    procd_set_param command /usr/share/cloud-ddns/cloud-ddns.sh
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    restart
}

service_triggers() {
    procd_add_reload_trigger cloud-ddns
}