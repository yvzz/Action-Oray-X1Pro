#!/bin/sh /etc/rc.common

START=80
USE_PROCD=1
NAME=cloud-ddns

start_service() {
    local dp_enabled ali_enabled
    dp_enabled=$(uci -q get cloud-ddns.dnspod.enabled)
    ali_enabled=$(uci -q get cloud-ddns.alidns.enabled)

    [ "$dp_enabled" = "1" ] || [ "$ali_enabled" = "1" ] || return 0

    procd_open_instance
    procd_set_param command /usr/share/cloud-ddns/cloud-ddns.sh
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

reload_service() {
    restart
}

service_triggers() {
    procd_add_reload_trigger cloud-ddns
}