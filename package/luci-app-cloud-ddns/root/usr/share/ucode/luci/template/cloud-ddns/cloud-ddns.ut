{# luci-app-cloud-ddns — Cloud DDNS 设置页（ucode 模板，勿改用 Lua 的 <% %> 语法） #}

{%
	import { cursor } from 'uci';

	let uci = cursor();
	let enc = (v) => entityencode(v ?? '');

	let dp_enabled = uci.get_first('cloud-ddns', 'dnspod', 'enabled');
	let dp_time    = uci.get_first('cloud-ddns', 'dnspod', 'time') ?? '600';
	let dp_mode    = uci.get_first('cloud-ddns', 'dnspod', 'mode') ?? 'token';
	let dp_token   = uci.get_first('cloud-ddns', 'dnspod', 'artoken') ?? '';
	let dp_email   = uci.get_first('cloud-ddns', 'dnspod', 'login_email') ?? '';
	let dp_passwd  = uci.get_first('cloud-ddns', 'dnspod', 'login_password') ?? '';

	let ali_enabled = uci.get_first('cloud-ddns', 'alidns', 'enabled');
	let ali_key     = uci.get_first('cloud-ddns', 'alidns', 'app_key') ?? '';
	let ali_secret  = uci.get_first('cloud-ddns', 'alidns', 'app_secret') ?? '';

	let ipv4_source = uci.get_first('cloud-ddns', 'ip', 'ipv4_source') ?? 'internet';
	let ipv6_source = uci.get_first('cloud-ddns', 'ip', 'ipv6_source') ?? 'internet';

	let url_status  = dispatcher.build_url('admin/services/cloud-ddns/status');
	let url_log     = dispatcher.build_url('admin/services/cloud-ddns/log');
	let url_restart = dispatcher.build_url('admin/services/cloud-ddns/restart');
	let url_save    = dispatcher.build_url('admin/services/cloud-ddns/save');

	/* 供页面 JS 使用的翻译文本（sprintf('%J') 生成带引号的 JSON 字符串） */
	let T = {
		running: sprintf('%J', _('运行中')),
		stopped: sprintf('%J', _('未运行')),
		nolog:   sprintf('%J', _('暂无日志')),
		del:     sprintf('%J', _('删除')),
		saved:   sprintf('%J', _('保存成功')),
		failed:  sprintf('%J', _('保存失败')),
		restarting: sprintf('%J', _('重启中…')),
		restartOk:  sprintf('%J', _('重启命令已下发')),
		saving:     sprintf('%J', _('保存中…')),
		noLog:   sprintf('%J', _('暂无日志。可能原因：服务未启用（DNSPod / AliDNS 都未勾选启用）、未产生输出，或日志已被清理。')),
		loadFail: sprintf('%J', _('读取失败'))
	};
-%}

{% include('header') %}

<h2 name="content">{{ _('Cloud DDNS') }}</h2>

<script type="text/javascript">//<![CDATA[
	var CD_TXT = {
		running: {{ T.running }},
		stopped: {{ T.stopped }},
		nolog:   {{ T.nolog }},
		del:     {{ T.del }},
		saved:   {{ T.saved }},
		failed:  {{ T.failed }}
	};

	var CD_logTimer = null;

	function CD_updateStatus() {
		var el = document.getElementById('cd_status');

		XHR.get('{{ url_status }}', null, function(x, d) {
			if (!el) return;
			el.innerHTML = (d && d.running)
				? '<span style="color:#090;font-weight:bold">● ' + CD_TXT.running + '</span>'
				: '<span style="color:#c00;font-weight:bold">● ' + CD_TXT.stopped + '</span>';
		}, 15000).catch(function() {
			if (el) el.innerHTML = '<span style="color:#c00">' + CD_TXT.loadFail + '</span>';
		});
	}

	function CD_loadLog() {
		var ta = document.getElementById('cd_log');

		XHR.get('{{ url_log }}', null, function(x) {
			if (!ta) return;

			var txt = (x.responseText || '').replace(/\s+$/, '');
			var keepBottom = (ta.scrollTop + ta.clientHeight >= ta.scrollHeight - 20);

			ta.value = (txt === '') ? CD_TXT.noLog : txt.split('\n').slice(-200).join('\n');
			ta.scrollTop = keepBottom ? ta.scrollHeight : 0;

			var mt = document.getElementById('cd_logtime');
			if (mt) mt.innerHTML = new Date().toLocaleTimeString();
		}, 15000).catch(function() {
			if (ta) ta.value = CD_TXT.loadFail;
		});
	}

	/* 日志自动刷新开关（默认开，10s 一次） */
	function CD_setAutoLog(on) {
		if (CD_logTimer) { clearInterval(CD_logTimer); CD_logTimer = null; }
		if (on) CD_logTimer = setInterval(CD_loadLog, 10000);
	}

	/* 按钮即时反馈：busy 期间禁用 + 换文案，结束后还原 */
	function CD_busy(btn, busy, busyText, doneText) {
		if (!btn) return;
		if (busy) {
			btn.oldText = btn.innerHTML;
			btn.disabled = true;
			btn.innerHTML = busyText;
		}
		else if (doneText) {
			btn.innerHTML = doneText;
			setTimeout(function() {
				btn.innerHTML = btn.oldText;
				btn.disabled = false;
			}, 1800);
		}
		else {
			btn.innerHTML = btn.oldText;
			btn.disabled = false;
		}
	}

	function CD_restart() {
		var btn = document.getElementById('cd_btn_restart');

		CD_busy(btn, true, CD_TXT.restarting);

		XHR.get('{{ url_restart }}', null, function() {
			CD_busy(btn, false, null, CD_TXT.restartOk);
			setTimeout(function() { CD_updateStatus(); CD_loadLog(); }, 2000);
		}, 20000).catch(function(e) {
			CD_busy(btn, false);
			alert(CD_TXT.failed + ': ' + (e && e.message ? e.message : ''));
		});
	}

	function CD_toggleMode() {
		var mode = document.getElementById('dnspod_mode').value;
		document.getElementById('dnspod_token_row').style.display = (mode === 'token') ? '' : 'none';
		document.getElementById('dnspod_email_row').style.display = (mode === 'login') ? '' : 'none';
		document.getElementById('dnspod_pass_row').style.display  = (mode === 'login') ? '' : 'none';
	}

	function CD_addRow() {
		var tbl = document.getElementById('cd_domains');
		var idx = tbl.rows.length - 1;
		var tr = tbl.insertRow(-1);
		tr.innerHTML =
			'<td><select class="cbi-input-select" name="domain_' + idx + '_provider">' +
				'<option value="dnspod">DNSPod</option>' +
				'<option value="alidns">AliDNS</option></select></td>' +
			'<td><select class="cbi-input-select" name="domain_' + idx + '_record_type">' +
				'<option value="A">A</option>' +
				'<option value="AAAA">AAAA</option></select></td>' +
			'<td><input type="text" class="cbi-input-text" name="domain_' + idx + '_main_domain" style="width:150px" placeholder="example.com" /></td>' +
			'<td><input type="text" class="cbi-input-text" name="domain_' + idx + '_sub_domain" style="width:100px" placeholder="www" /></td>' +
			'<td><button class="btn cbi-button" type="button" onclick="this.closest(\'tr\').remove()">' + CD_TXT.del + '</button></td>';
	}

	function CD_save() {
		var data = {};
		var btn = document.getElementById('cd_btn_save');

		new FormData(document.getElementById('cd_form')).forEach(function(v, k) {
			data[k] = v;
		});

		if (data.dnspod_enabled == null) data.dnspod_enabled = '0';
		if (data.ali_enabled == null) data.ali_enabled = '0';

		CD_busy(btn, true, CD_TXT.saving);

		XHR.post('{{ url_save }}', data, function(x, d) {
			CD_busy(btn, false);
			alert((d && d.ok) ? CD_TXT.saved : CD_TXT.failed);
			setTimeout(function() { CD_updateStatus(); CD_loadLog(); }, 2000);
		}, 20000).catch(function(e) {
			CD_busy(btn, false);
			alert(CD_TXT.failed + ': ' + (e && e.message ? e.message : ''));
		});
	}

	document.addEventListener('DOMContentLoaded', function() {
		CD_updateStatus();
		CD_loadLog();
		CD_toggleMode();

		/* 状态 30s、日志 10s 自动刷新 */
		setInterval(CD_updateStatus, 30000);
		CD_setAutoLog(true);

		document.getElementById('dnspod_mode').addEventListener('change', CD_toggleMode);
		document.getElementById('cd_autolog').addEventListener('change', function(ev) {
			CD_setAutoLog(ev.target.checked);
		});
		document.getElementById('cd_form').addEventListener('submit', function(ev) {
			ev.preventDefault();
			CD_save();
		});
	});
//]]></script>

<form id="cd_form">
	<div class="cbi-map">

		<div class="cbi-section">
			<div class="cbi-value">
				<label class="cbi-value-title">{{ _('服务状态') }}</label>
				<div class="cbi-value-field">
					<span id="cd_status"><em>{{ _('检查中...') }}</em></span>
				</div>
			</div>
		</div>

		<h3>{{ _('DNSPod 设置') }}</h3>
		<div class="cbi-section">
			<div class="cbi-value">
				<label class="cbi-value-title">{{ _('启用 DNSPod') }}</label>
				<div class="cbi-value-field">
					<input type="checkbox" name="dnspod_enabled" value="1"{% if (dp_enabled == '1'): %} checked="checked"{% endif %} />
				</div>
			</div>
			<div class="cbi-value">
				<label class="cbi-value-title">{{ _('检查间隔(秒)') }}</label>
				<div class="cbi-value-field">
					<input type="text" class="cbi-input-text" name="dnspod_time" value="{{ enc(dp_time) }}" style="width:120px" />
				</div>
			</div>
			<div class="cbi-value">
				<label class="cbi-value-title">{{ _('解析模式') }}</label>
				<div class="cbi-value-field">
					<select class="cbi-input-select" name="dnspod_mode" id="dnspod_mode">
						<option value="token"{% if (dp_mode != 'login'): %} selected="selected"{% endif %}>{{ _('Token 解析') }}</option>
						<option value="login"{% if (dp_mode == 'login'): %} selected="selected"{% endif %}>{{ _('账号解析') }}</option>
					</select>
				</div>
			</div>
			<div class="cbi-value" id="dnspod_token_row">
				<label class="cbi-value-title">{{ _('ID,Token') }}</label>
				<div class="cbi-value-field">
					<input type="text" class="cbi-input-text" name="dnspod_artoken" value="{{ enc(dp_token) }}" style="width:300px" placeholder="12345,abcdefg" />
				</div>
			</div>
			<div class="cbi-value" id="dnspod_email_row">
				<label class="cbi-value-title">{{ _('登录邮箱') }}</label>
				<div class="cbi-value-field">
					<input type="text" class="cbi-input-text" name="dnspod_login_email" value="{{ enc(dp_email) }}" style="width:250px" />
				</div>
			</div>
			<div class="cbi-value" id="dnspod_pass_row">
				<label class="cbi-value-title">{{ _('登录密码') }}</label>
				<div class="cbi-value-field">
					<input type="password" class="cbi-input-password" name="dnspod_login_password" value="{{ enc(dp_passwd) }}" style="width:250px" />
				</div>
			</div>
		</div>

		<h3>{{ _('AliDNS 设置') }}</h3>
		<div class="cbi-section">
			<div class="cbi-value">
				<label class="cbi-value-title">{{ _('启用 AliDNS') }}</label>
				<div class="cbi-value-field">
					<input type="checkbox" name="ali_enabled" value="1"{% if (ali_enabled == '1'): %} checked="checked"{% endif %} />
				</div>
			</div>
			<div class="cbi-value">
				<label class="cbi-value-title">{{ _('Access Key ID') }}</label>
				<div class="cbi-value-field">
					<input type="text" class="cbi-input-text" name="ali_app_key" value="{{ enc(ali_key) }}" style="width:300px" />
				</div>
			</div>
			<div class="cbi-value">
				<label class="cbi-value-title">{{ _('Access Key Secret') }}</label>
				<div class="cbi-value-field">
					<input type="password" class="cbi-input-password" name="ali_app_secret" value="{{ enc(ali_secret) }}" style="width:300px" />
				</div>
			</div>
		</div>

		<h3>{{ _('IP 获取设置') }}</h3>
		<div class="cbi-section">
			<div class="cbi-value">
				<label class="cbi-value-title">{{ _('IPv4 来源') }}</label>
				<div class="cbi-value-field">
					<select class="cbi-input-select" name="ipv4_source">
						<option value="internet"{% if (ipv4_source != 'wan'): %} selected="selected"{% endif %}>{{ _('Internet (公网获取)') }}</option>
						<option value="wan"{% if (ipv4_source == 'wan'): %} selected="selected"{% endif %}>{{ _('WAN 接口') }}</option>
					</select>
				</div>
			</div>
			<div class="cbi-value">
				<label class="cbi-value-title">{{ _('IPv6 来源') }}</label>
				<div class="cbi-value-field">
					<select class="cbi-input-select" name="ipv6_source">
						<option value="internet"{% if (ipv6_source != 'wan'): %} selected="selected"{% endif %}>{{ _('Internet (公网获取)') }}</option>
						<option value="wan"{% if (ipv6_source == 'wan'): %} selected="selected"{% endif %}>{{ _('WAN 接口') }}</option>
					</select>
				</div>
			</div>
		</div>

		<h3>{{ _('域名列表') }}</h3>
		<div class="cbi-section">
			<table class="table" id="cd_domains">
				<tr>
					<th>{{ _('服务商') }}</th>
					<th>{{ _('记录类型') }}</th>
					<th>{{ _('主域名') }}</th>
					<th>{{ _('子域名') }}</th>
					<th></th>
				</tr>
				{% let i = 0; %}
				{% uci.foreach('cloud-ddns', 'domain', (s) => { %}
				<tr>
					<td>
						<select class="cbi-input-select" name="domain_{{ i }}_provider">
							<option value="dnspod"{% if (s.provider != 'alidns'): %} selected="selected"{% endif %}>DNSPod</option>
							<option value="alidns"{% if (s.provider == 'alidns'): %} selected="selected"{% endif %}>AliDNS</option>
						</select>
					</td>
					<td>
						<select class="cbi-input-select" name="domain_{{ i }}_record_type">
							<option value="A"{% if (s.record_type != 'AAAA'): %} selected="selected"{% endif %}>A</option>
							<option value="AAAA"{% if (s.record_type == 'AAAA'): %} selected="selected"{% endif %}>AAAA</option>
						</select>
					</td>
					<td><input type="text" class="cbi-input-text" name="domain_{{ i }}_main_domain" value="{{ enc(s.main_domain) }}" style="width:150px" placeholder="example.com" /></td>
					<td><input type="text" class="cbi-input-text" name="domain_{{ i }}_sub_domain" value="{{ enc(s.sub_domain) }}" style="width:100px" placeholder="www" /></td>
					<td><button class="btn cbi-button" type="button" onclick="this.closest('tr').remove()">{{ _('删除') }}</button></td>
				</tr>
				{% i++; }); %}
			</table>
			<button class="btn cbi-button" type="button" onclick="CD_addRow()">{{ _('+ 添加域名') }}</button>
		</div>

		<div class="cbi-page-actions">
			<button id="cd_btn_save" class="btn cbi-button cbi-button-apply" type="submit">{{ _('保存并应用') }}</button>
			<button id="cd_btn_restart" class="btn cbi-button" type="button" onclick="CD_restart()">{{ _('重启服务') }}</button>
		</div>
	</div>
</form>

<h3>{{ _('运行日志') }}</h3>
<div class="cbi-section">
	<textarea id="cd_log" class="cbi-input-textarea" readonly style="width:100%;height:300px;font-family:monospace;font-size:12px"></textarea>
	<div class="cbi-page-actions">
		<button class="btn cbi-button" type="button" onclick="CD_loadLog()">{{ _('刷新日志') }}</button>
		<label style="margin-left:1em">
			<input type="checkbox" id="cd_autolog" checked="checked" /> {{ _('自动刷新（10 秒）') }}
		</label>
		<span style="margin-left:1em;color:#888">{{ _('最后刷新') }}: <span id="cd_logtime">—</span></span>
	</div>
</div>

{% include('footer') %}
