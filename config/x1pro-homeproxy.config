CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_oray_x1pro=y
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_CCACHE_DIR="/workdir/.ccache"
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-netlink-diag=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-tun=y
# USB 4G 随身WiFi（modem）支持
CONFIG_PACKAGE_kmod-usb-net-rndis=y
CONFIG_PACKAGE_kmod-usb-net-cdc-ether=y
CONFIG_PACKAGE_luci-app-homeproxy=y
CONFIG_PACKAGE_luci-i18n-homeproxy-zh-cn=y
CONFIG_PACKAGE_luci-ssl-openssl=y
CONFIG_PACKAGE_openssl-util=y
CONFIG_PACKAGE_sing-box=y
# ── 通用功能（与其它 25.12 配置保持一致）──
CONFIG_PACKAGE_luci-theme-aurora=y
CONFIG_PACKAGE_luci-app-aurora-config=y

CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-upnp=y
CONFIG_PACKAGE_miniupnpd-nftables=y
CONFIG_PACKAGE_luci-app-wifischedule=y
CONFIG_PACKAGE_luci-app-autoreboot=y
# ── NPC (NPS 客户端，所有 25.12 版本统一集成) ──
CONFIG_PACKAGE_npc=y
CONFIG_PACKAGE_luci-app-npc=y
CONFIG_PACKAGE_luci-i18n-npc-zh-cn=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-compat-keep=y
# ── EasyTier 组网（与 24.10 对齐，所有 25.12 版本统一集成）──
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-app-easytier=y
CONFIG_PACKAGE_luci-i18n-easytier-zh-cn=y
# ── VNT2 组网（界面包；核心二进制由设备在 LuCI 内下载）──
CONFIG_PACKAGE_luci-app-vnt2=y
CONFIG_PACKAGE_luci-i18n-vnt2-zh-cn=y
# ── 全能推送 (luci-app-pushbot) ──
CONFIG_PACKAGE_luci-app-pushbot=y
CONFIG_PACKAGE_luci-app-cloud-ddns=y
CONFIG_PACKAGE_luci-i18n-cloud-ddns-zh-cn=y
# cloud-ddns 的 LUCI_DEPENDS 含 +bash（cloud-ddns.sh 是 #!/bin/bash），必须显式选中：
# 否则 make defconfig 会因依赖不满足把 luci-app-cloud-ddns 关掉，verify 步骤随即 exit 1
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_iputils-arping=y
CONFIG_PACKAGE_jq=y
# ── BusyBox：启用 stty（down-scripts.sh 交互需要 raw 终端模式）──

# Disable broken ATF RAM-boot variants (upstream TF-A source does not produce bl2.bin)
CONFIG_PACKAGE_trusted-firmware-a-mt7981-ram-ddr3=n
CONFIG_PACKAGE_trusted-firmware-a-mt7981-ram-ddr4=n
CONFIG_PACKAGE_trusted-firmware-a-mt7986-ram-ddr3=n
CONFIG_PACKAGE_trusted-firmware-a-mt7986-ram-ddr4=n
CONFIG_PACKAGE_trusted-firmware-a-mt7988-ram-comb=n
