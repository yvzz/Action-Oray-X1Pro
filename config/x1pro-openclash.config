
# Disable broken ATF RAM-boot variants (upstream TF-A source does not produce bl2.bin)
CONFIG_PACKAGE_trusted-firmware-a-mt7981-ram-ddr3=n
CONFIG_PACKAGE_trusted-firmware-a-mt7981-ram-ddr4=n
CONFIG_PACKAGE_trusted-firmware-a-mt7986-ram-ddr3=n
CONFIG_PACKAGE_trusted-firmware-a-mt7986-ram-ddr4=n
CONFIG_PACKAGE_trusted-firmware-a-mt7988-ram-comb=n

# Additional broken ATF RAM-boot variants (upstream added MT7987/MT7988 later)
CONFIG_PACKAGE_trusted-firmware-a-mt7987-ram-comb=n
CONFIG_PACKAGE_trusted-firmware-a-mt7988-ram-ddr3=n
CONFIG_PACKAGE_trusted-firmware-a-mt7988-ram-ddr4=n

# ── rtp2httpd: IPTV 组播 RTP/RTSP 转 HTTP（包源码由 diy-part1.sh 从 GitHub clone 到 package/）──
CONFIG_PACKAGE_rtp2httpd=y
CONFIG_PACKAGE_luci-app-rtp2httpd=y
CONFIG_PACKAGE_luci-i18n-rtp2httpd-zh-cn=y
