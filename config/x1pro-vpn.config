# ImmortalWrt 25.12 (mediatek/filogic) diffconfig — 仅保留显式选择，其余由 make defconfig 自动补全
# 目标设备
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_oray_x1pro=y
# 构建选项
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_CCACHE_DIR="/workdir/.ccache"
# 显式软件包（非基础库/非内核模块，基础系统包由 defconfig 自动补全）
CONFIG_PACKAGE_luci-compat-keep=y
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
